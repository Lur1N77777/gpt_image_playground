name = "gpt-image-playground-worker"
main = "workers/image-consumer.ts"
compatibility_date = "2026-04-25"

[[d1_databases]]
binding = "IMAGE_DB"
database_name = "gpt-image-playground-db"
database_id = "<D1_DATABASE_ID>"

[[r2_buckets]]
binding = "IMAGE_BUCKET"
bucket_name = "gpt-image-playground-images"

[[queues.consumers]]
queue = "gpt-image-playground-jobs"
max_batch_size = 1
max_batch_timeout = 5
max_retries = 1
